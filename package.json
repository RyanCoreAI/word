{
  "name": "yanxai-word",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "lint": "eslint apps/web/src packages/core",
    "test": "vitest run",
    "build": "npm run typecheck && vite build && node tools/build-offline.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "pipeline": "python tools/pipeline/build.py",
    "deploy": "npm run build && npm exec --yes --package=wrangler@4.151.3 -- wrangler deploy"
  },
  "dependencies": {
    "@fontsource/inter": "5.3.0",
    "@fontsource/noto-sans-sc": "5.3.1",
    "@fontsource/source-serif-4": "5.3.1",
    "@huggingface/transformers": "4.3.1",
    "lucide-react": "1.61.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "fake-indexeddb": "6.2.6",
    "lucide-static": "1.61.0",
    "playwright": "1.64.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
